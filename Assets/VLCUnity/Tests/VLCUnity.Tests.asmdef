{
    "name": "VLCUnity.Tests",
    "rootNamespace": "Videolabs.VLCUnity.Tests",
    "references": [
        "VLCUnity",
        "VLCUnity.Demos",
        "UnityEngine.TestRunner",
        "UnityEditor.TestRunner"
    ],
    "includePlatforms": [
        "Editor"
    ],
    "excludePlatforms": [],
    "allowUnsafeCode": false,
    "overrideReferences": true,
    "precompiledReferences": [
        "LibVLCSharp.dll",
        "nunit.framework.dll"
    ],
    "autoReferenced": true,
    "defineConstraints": [
        "UNITY_INCLUDE_TESTS",
        "VLC_HAS_TEST_FRAMEWORK"
    ],
    "versionDefines": [
        {
            "name": "com.unity.test-framework",
            "expression": "1.0.0",
            "define": "VLC_HAS_TEST_FRAMEWORK"
        }
    ],
    "noEngineReferences": false
}
